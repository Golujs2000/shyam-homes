rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Properties: Public can view; Admin/App can manage
    match /properties/{propertyId} {
      allow read: if true;
      allow write: if true;
    }

    // Leads: Public can submit inquiries & seller requests; Admin can manage
    match /leads/{leadId} {
      allow read, write: if true;
    }

    // Visits: Public can book site visits; Admin can confirm & manage
    match /visits/{visitId} {
      allow read, write: if true;
    }

    // Enquiries: Public can send messages; Admin can review & manage
    match /enquiries/{enquiryId} {
      allow read, write: if true;
    }

    // Settings: Public can read phone, email, consultant details; Admin can update
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
