rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Listing request media: public users can upload images & videos
    match /listing-requests/{requestId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 55 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*'));
    }

    // Property images managed by admin
    match /properties/{propertyId}/{fileName} {
      allow read: if true;
      allow write: if true;
    }
  }
}
